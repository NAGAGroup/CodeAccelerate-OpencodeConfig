{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "default_agent": "headwrench",
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "context-scout": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "documentation-expert": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "junior-dev": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "context-insurgent": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "external-scout": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "tailwrench": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "autonomous-agent": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "compaction": {
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "probe": {
      "type": "local",
      "command": ["npx", "-y", "@probelabs/probe@latest", "mcp"],
      "enabled": true
    },
    // Semantic session memory. Stores and retrieves findings by meaning across DAG steps.
    // Uses local embedded Qdrant (no server required) + FastEmbed for local embeddings.
    // First use downloads the embedding model (~90MB, one-time).
    "qdrant": {
      "type": "local",
      "command": ["uvx", "mcp-server-qdrant"],
      "environment": {
        "QDRANT_LOCAL_PATH": ".opencode/qdrant",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true,
      "timeout": 30000
    },
    // Self-hosted web search. Requires a running SearXNG instance on localhost:8080.
    // To spin up a local instance: docker run -d -p 8080:8080 searxng/searxng
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "enabled": true
    }
  }
}
