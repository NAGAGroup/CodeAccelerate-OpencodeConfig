{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "github-copilot": {
      "models": {
        "claude-sonnet-4.6": {
          "variants": {
            "default": {
              "reasoning": false,
              "reasoningEffort": "medium"
            }
          }
        },
        "claude-haiku-4.5": {
          "variants": {
            "default": {
              "reasoning": false,
              "reasoningEffort": "medium"
            }
          }
        }
      }
    }
  },
  "autoupdate": false,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "file://{env:HOME}/.config/opencode/plugins/planning-enforcement.js"
  ],
  "default_agent": "headwrench",
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "context-scout": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "documentation-expert": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "junior-dev": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "context-insurgent": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "external-scout": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "tailwrench": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "autonomous-agent": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "dag-designer": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "dag-reviewer": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "compaction": {
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "grepai": {
      "type": "local",
      "command": ["grepai", "mcp-serve"],
      "enabled": true
    },
    // Semantic session memory. Stores and retrieves findings by meaning across DAG steps.
    // Connects to a shared Qdrant server instance (supports concurrent sessions).
    // Start the server once: docker run -d --name qdrant -p 6333:6333 qdrant/qdrant
    // Or without Docker: uvx mcp-server-qdrant
    "qdrant": {
      "type": "local",
      "command": ["uvx", "mcp-server-qdrant"],
      "environment": {
        "QDRANT_URL": "http://localhost:6333",
        "EMBEDDING_MODEL": "sentence-transformers/all-MiniLM-L6-v2"
      },
      "enabled": true,
      "timeout": 30000
    },
    // Self-hosted web search. Requires a running SearXNG instance on localhost:8080.
    // To spin up a local instance: docker run -d -p 8080:8080 searxng/searxng
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "environment": {
        "SEARXNG_URL": "http://localhost:8080"
      },
      "enabled": true
    }
  }
}
