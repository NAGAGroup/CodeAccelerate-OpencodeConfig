{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "ollama/opencode-model",
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "default_agent": "headwrench",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "opencode-model": {
          "name": "Default Ollama"
        }
      }
    }
  },
  // Recommended model (2026, RTX 4090 24GB VRAM):
  //   ollama pull qwen2.5:14b
  //   Tool-calling F1: 0.971 (High confidence) — 9-10GB VRAM at Q4_K_M
  //   Context: 32K native; set num_ctx 16384 in Modelfile for safe VRAM margin
  //
  // KV cache optimization (cuts context VRAM ~50%):
  //   export OLLAMA_KV_CACHE_TYPE=q8_0
  //   export OLLAMA_FLASH_ATTENTION=1
  //   ollama serve
  //
  // Secondary: mistral-small (24B, Q4_K_M, ~15.9GB, purpose-built function calling, Medium confidence)
  //   ollama pull mistral-small
  //   OR: ollama pull hf.co/bartowski/Mistral-Small-3.2-24B-Instruct-2506-GGUF:Q4_K_M
  // Alternative: qwen3:32b (32B, Q4_K_M, ~20.7GB, agentic design, Low confidence, tight KV headroom)
  // Fallback: llama3.1:8b (Q4_K_M, 5-6GB, 89% tool accuracy)
  // Do NOT use 70B+ models — zero VRAM for KV cache, context collapses to <2K
  // Full report: docs/reports/ollama-model-recommendations.md
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "model": "ollama/opencode-model"
    },
    "context-scout": {
      "model": "ollama/opencode-model"
    },
    "quick-doc": {
      "model": "ollama/opencode-model"
    },
    "junior-dev": {
      "model": "ollama/opencode-model"
    },
    "context-insurgent": {
      "model": "ollama/opencode-model"
    },
    "external-scout": {
      "model": "ollama/opencode-model"
    },
    "compaction": {
      "model": "ollama/opencode-model"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}&tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "enabled": true
    }
  }
}