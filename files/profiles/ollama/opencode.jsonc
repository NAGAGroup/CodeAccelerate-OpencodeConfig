{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "ollama/opencode-model",
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "default_agent": "headwrench",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "opencode-model": {
          "name": "Default Ollama"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "model": "ollama/opencode-model"
    },
    "context-scout": {
      "model": "ollama/opencode-model"
    },
    "quick-doc": {
      "model": "ollama/opencode-model"
    },
    "junior-dev": {
      "model": "ollama/opencode-model"
    },
    "context-insurgent": {
      "model": "ollama/opencode-model"
    },
    "external-scout": {
      "model": "ollama/opencode-model"
    },
    "compaction": {
      "model": "ollama/opencode-model"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}&tools=web_search_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
      "enabled": true
    }
  }
}