// Node Type Registry and Manifest — CodeAccelerate Task Library v2.0
// Single source of truth for all 13 node type definitions and metadata
// Last Updated: 2026-03-27
// Schema Compliance: DAG v2.0

{
  "version": "2.0",
  "schema_compliance": "DAG v2.0",
  "compliance_verified": true,
  "last_audit_date": "2026-03-27",
  "library": "CodeAccelerate Task Library",
  "description": "13 modular node types for DAG-driven planning workflows",
  "total_nodes": 13,
  
  "valid_todo_items": [
    "task",
    "question",
    "bash",
    "skill",
    "[]"
  ],
  
  "deprecated_items": [
    "observation",
    "compress",
    "analyze",
    "research"
  ],
  
  "nodes": [
    // Entry/Initialization Nodes
    {
      "id": "session-overview",
      "name": "Session Overview",
      "description": "Introduce planning mode and read session state. Auto-advances without agent dispatch.",
      "category": "entry",
      "template": "session-overview.md",
      "primary_agent": "HeadWrench",
      "step_budget": 0,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": true,
      "todo_sequence": [],
      "branching_type": "linear",
      "use_cases": [
        "First node in every planning DAG",
        "Session introduction and context priming",
        "Session resumption or handoff"
      ]
    },
    
    {
      "id": "intake",
      "name": "Information Intake",
      "description": "Gather user intent, refine problem statement, establish acceptance criteria.",
      "category": "entry",
      "template": "intake.md",
      "primary_agent": "HeadWrench",
      "step_budget": 5,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["question"],
      "branching_type": "linear",
      "use_cases": [
        "Formalize user requirements",
        "Define scope boundaries",
        "Establish success metrics"
      ]
    },
    
    // Exploration/Analysis Nodes
    {
      "id": "scout-parallel",
      "name": "Parallel Scouting",
      "description": "Coordinate 3 independent parallel explorations of codebase via context-scout.",
      "category": "exploration",
      "template": "scout-parallel.md",
      "primary_agent": "context-scout",
      "step_budget": 12,
      "enabled": true,
      "parallelizable": true,
      "parallel_task_count": 3,
      "auto_advance": false,
      "todo_sequence": ["task", "task", "task"],
      "branching_type": "linear",
      "use_cases": [
        "Early exploration from multiple angles",
        "Leverage parallel execution to reduce time",
        "Independent exploration tasks"
      ]
    },
    
    {
      "id": "analyze-deep",
      "name": "Deep Analysis",
      "description": "Synthesize scout findings and form implementation hypothesis via context-insurgent.",
      "category": "exploration",
      "template": "analyze-deep.md",
      "primary_agent": "context-insurgent",
      "step_budget": 20,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["task"],
      "branching_type": "linear",
      "use_cases": [
        "Comprehensive synthesis across areas",
        "Strategy formation before execution",
        "Complex analysis requiring sustained focus"
      ]
    },
    
    {
      "id": "skill-invoke",
      "name": "Skill Execution",
      "description": "Dispatch a delegated skill (decompose, refactor, research) with internal subtask management.",
      "category": "exploration",
      "template": "skill-invoke.md",
      "primary_agent": "Delegated",
      "step_budget": 15,
      "enabled": true,
      "parallelizable": true,
      "auto_advance": false,
      "todo_sequence": ["skill"],
      "branching_type": "linear",
      "use_cases": [
        "Well-defined, repetitive work delegation",
        "Composition/decomposition logic",
        "Research or specialized analysis via MCP"
      ]
    },
    
    // Execution Nodes
    {
      "id": "parallel-tasks",
      "name": "Parallel Work",
      "description": "Dispatch 2–4 independent work items (code, tests, docs) to junior-dev in parallel.",
      "category": "execution",
      "template": "parallel-tasks.md",
      "primary_agent": "junior-dev",
      "step_budget": 10,
      "enabled": true,
      "parallelizable": true,
      "parallel_task_count": 3,
      "auto_advance": false,
      "todo_sequence": ["task", "task", "task"],
      "branching_type": "linear",
      "use_cases": [
        "Execute independent code changes",
        "No cross-task dependencies",
        "Reduce execution time via parallelism"
      ]
    },
    
    {
      "id": "compression-node",
      "name": "Compression & Summary",
      "description": "Aggregate and synthesize outputs from parallel branches into unified summary via context-insurgent.",
      "category": "execution",
      "template": "compression-node.md",
      "primary_agent": "context-insurgent",
      "step_budget": 20,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["task"],
      "branching_type": "linear",
      "use_cases": [
        "Summarize parallel branch outputs",
        "Reduce context noise before verification",
        "Prepare handoff to terminal"
      ]
    },
    
    // Control Flow Nodes
    {
      "id": "decision-gate",
      "name": "User Decision Gate",
      "description": "Present multiple strategies to user and branch based on selection.",
      "category": "control",
      "template": "decision-gate.md",
      "primary_agent": "HeadWrench",
      "step_budget": 5,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["question"],
      "branching_type": "conditional",
      "branching_criteria": "user_input",
      "use_cases": [
        "Present multiple strategy options",
        "Get explicit user approval",
        "Split DAG into alternative paths"
      ]
    },
    
    {
      "id": "conditional-branch",
      "name": "Conditional Branch",
      "description": "Execute command and branch based on exit code (0=success, 1=fail, 2=error).",
      "category": "control",
      "template": "conditional-branch.md",
      "primary_agent": "HeadWrench",
      "step_budget": 5,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["bash"],
      "branching_type": "conditional",
      "branching_criteria": "exit_code",
      "exit_codes": [0, 1, 2],
      "use_cases": [
        "Run tests with pass/fail routing",
        "Validate build output",
        "Environment checks with specific codes"
      ]
    },
    
    {
      "id": "loop-until-success",
      "name": "Exhaustion Loop",
      "description": "Retry bash command up to max iterations (default 3) until exit code 0 or max reached.",
      "category": "control",
      "template": "loop-until-success.md",
      "primary_agent": "HeadWrench",
      "step_budget": 5,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["bash"],
      "branching_type": "conditional",
      "branching_criteria": "exit_code_and_iteration_count",
      "max_iterations": 3,
      "use_cases": [
        "Retry failed tests or builds",
        "Flaky environment checks",
        "Automatic recovery attempts"
      ]
    },
    
    {
      "id": "verification-check",
      "name": "Verification Gate",
      "description": "Validate output (tests, build, lint) against criteria; branch on exit code via junior-dev.",
      "category": "control",
      "template": "verification-check.md",
      "primary_agent": "junior-dev",
      "step_budget": 10,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": false,
      "todo_sequence": ["bash"],
      "branching_type": "conditional",
      "branching_criteria": "exit_code",
      "exit_codes": [0, 1, 2],
      "use_cases": [
        "Validate code quality and functionality",
        "Gate progress to terminal on criteria",
        "Provide diagnostic feedback on failures"
      ]
    },
    
    // Terminal Nodes
    {
      "id": "output-success",
      "name": "Success Terminal",
      "description": "Conclude with success, generate final artifact/summary. Auto-advances.",
      "category": "terminal",
      "template": "output-success.md",
      "primary_agent": "HeadWrench",
      "step_budget": 0,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": true,
      "todo_sequence": [],
      "branching_type": "none",
      "use_cases": [
        "Final node in successful paths",
        "Generate summary or deliverable",
        "Communicate completion to user"
      ]
    },
    
    {
      "id": "output-failure",
      "name": "Failure Terminal",
      "description": "Conclude with failure, provide diagnostic info and error context. Auto-advances.",
      "category": "terminal",
      "template": "output-failure.md",
      "primary_agent": "HeadWrench",
      "step_budget": 0,
      "enabled": true,
      "parallelizable": false,
      "auto_advance": true,
      "todo_sequence": [],
      "branching_type": "none",
      "use_cases": [
        "Final node in failure paths",
        "Provide diagnostic information",
        "Communicate error with context"
      ]
    }
  ],
  
  "categories": {
    "entry": {
      "display_name": "Entry/Initialization",
      "order": 1,
      "description": "Starting points for DAGs; establish context and gather requirements",
      "nodes": ["session-overview", "intake"]
    },
    "exploration": {
      "display_name": "Exploration/Analysis",
      "order": 2,
      "description": "Investigative work; parallel scouting, synthesis, and skill invocation",
      "nodes": ["scout-parallel", "analyze-deep", "skill-invoke"]
    },
    "execution": {
      "display_name": "Execution",
      "order": 3,
      "description": "Implementation and aggregation; parallel work and compression",
      "nodes": ["parallel-tasks", "compression-node"]
    },
    "control": {
      "display_name": "Control Flow",
      "order": 4,
      "description": "Decision points and retry logic; branching and loops",
      "nodes": ["decision-gate", "conditional-branch", "loop-until-success", "verification-check"]
    },
    "terminal": {
      "display_name": "Terminal/Output",
      "order": 5,
      "description": "Endpoints for DAGs; success and failure conclusions",
      "nodes": ["output-success", "output-failure"]
    }
  },
  
  "agents": {
    "HeadWrench": {
      "tier": "sonnet",
      "role": "Orchestrator, planning, user interaction",
      "nodes": ["session-overview", "intake", "decision-gate", "conditional-branch", "loop-until-success", "output-success", "output-failure"]
    },
    "context-scout": {
      "tier": "haiku",
      "role": "Parallel exploration and context gathering",
      "nodes": ["scout-parallel"],
      "step_budget": 12,
      "parallelizable": true
    },
    "context-insurgent": {
      "tier": "sonnet",
      "role": "Deep analysis and synthesis",
      "nodes": ["analyze-deep", "compression-node"],
      "step_budget": 20,
      "parallelizable": false
    },
    "junior-dev": {
      "tier": "haiku",
      "role": "Code execution, testing, verification",
      "nodes": ["parallel-tasks", "verification-check"],
      "step_budget": 10,
      "parallelizable": true
    },
    "Delegated": {
      "tier": "varies",
      "role": "Skill execution with internal task management",
      "nodes": ["skill-invoke"],
      "step_budget": 15,
      "parallelizable": true
    }
  },
  
  "todo_semantics": {
    "task": {
      "description": "Dispatch work to an agent (analysis, code generation, planning)",
      "tool_mapped_to": "OpenCode task tool",
      "examples": ["Scout the codebase", "Analyze the error", "Write the function"],
      "contexts": ["execution", "analysis", "planning"]
    },
    "question": {
      "description": "Ask user for decision, input, or confirmation",
      "tool_mapped_to": "OpenCode question tool",
      "examples": ["Which approach?", "Approve changes?", "Provide context?"],
      "contexts": ["user_input", "decision_gates"]
    },
    "bash": {
      "description": "Execute shell command; branches on exit code (0, 1, 2, ...)",
      "tool_mapped_to": "OpenCode bash tool",
      "examples": ["npm test", "git diff", "bun run build"],
      "contexts": ["validation", "verification", "conditional_branching"],
      "branching": "Automatic on exit codes"
    },
    "skill": {
      "description": "Invoke a named delegated skill with internal subtask management",
      "tool_mapped_to": "Skill invocation via delegation framework",
      "examples": ["decompose", "refactor", "research"],
      "contexts": ["delegation", "specialized_work"]
    },
    "empty": {
      "description": "Auto-advance node; no tool invocation",
      "tool_mapped_to": "None (DAG engine auto-completes)",
      "examples": ["session-overview", "output-success", "output-failure"],
      "behavior": "Node completes immediately upon reaching it"
    }
  },
  
  "patterns": {
    "parallel_scouting": {
      "description": "Multiple parallel explorations from different angles",
      "node": "scout-parallel",
      "structure": {
        "todo": ["task", "task", "task"]
      },
      "example": "Explore API layer, database schema, and frontend code in parallel"
    },
    "user_decision_branching": {
      "description": "Present options and branch on user choice",
      "node": "decision-gate",
      "structure": {
        "todo": ["question"],
        "next": [
          { "when": "User chooses option A", "node": "..." },
          { "when": "User chooses option B", "node": "..." }
        ]
      },
      "example": "Approach A (refactor) vs. Approach B (rewrite) vs. More research"
    },
    "exit_code_branching": {
      "description": "Branch based on command exit code (0=success, 1=failure, 2=error)",
      "node": "conditional-branch",
      "structure": {
        "todo": ["bash"],
        "next": [
          { "when": "Exit code 0", "node": "..." },
          { "when": "Exit code 1", "node": "..." },
          { "when": "Exit code 2", "node": "..." }
        ]
      },
      "example": "Run tests: if pass → success terminal, if fail → loop-until-success"
    },
    "retry_loop": {
      "description": "Retry up to max iterations until success (exit code 0)",
      "node": "loop-until-success",
      "structure": {
        "todo": ["bash"],
        "next": [
          { "when": "Exit code 0", "node": "..." },
          { "when": "Iterations < max", "node": "loop-until-success" },
          { "when": "Iterations >= max", "node": "..." }
        ]
      },
      "example": "Retry npm install up to 3 times; if 3rd fails → error terminal"
    },
    "compression": {
      "description": "Aggregate parallel outputs before progressing",
      "node": "compression-node",
      "structure": {
        "todo": ["task"]
      },
      "example": "Summarize scout findings, analysis, and execution results into unified artifact"
    }
  },
  
  "audit_log": {
    "compliance_checks": [
      "All 13 nodes audited for v2.0 schema compliance",
      "Removed custom metadata from node definitions",
      "Standardized todo field format (valid items only)",
      "Updated prompt references to bare filenames",
      "Verified branching structure matches OpenCode semantics",
      "Validated all examples use v2.0 schema"
    ],
    "last_audit": "2026-03-27",
    "auditor": "CodeAccelerate QA",
    "status": "CERTIFIED"
  }
}
