{
  "schema_version": "1.0",
  "id": "plan-collaborative",
  "session_type": "plan-collaborative",
  "description": "Rough-idea-to-detailed-spec — planning produces seed plan only",
  "entry": "session-overview",
  "nodes": {
    "session-overview": {
      "id": "session-overview",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/session-overview.md",
      "next": "load-guidelines"
    },
    "load-guidelines": {
      "id": "load-guidelines",
      "type": "agent",
      "prompt": "planning/plan-design-guidelines.md",
      "next": "scout"
    },
    "scout": {
      "id": "scout",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/scout.md",
      "next": "idea-intake"
    },
    "idea-intake": {
      "id": "idea-intake",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/idea-intake.md",
      "next": "clarify"
    },
    "clarify": {
      "id": "clarify",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/clarify.md",
      "next": {
        "assess": {
          "desc": "Evaluate whether enough session-design context has been gathered.",
          "choose_when": "Clarifying question has been asked."
        }
      }
    },
    "assess": {
      "id": "assess",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/assess.md",
      "next": {
        "clarify": {
          "desc": "Continue gathering session-design context.",
          "choose_when": "More context needed before writing a seed plan."
        },
        "agent-routing": {
          "desc": "Proceed to agent routing.",
          "choose_when": "Enough context to write a seed plan."
        }
      }
    },
    "agent-routing": {
      "id": "agent-routing",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/agent-routing.md",
      "next": "info-prime"
    },
    "info-prime": {
      "id": "info-prime",
      "type": "agent",
      "prompt": "planning/_shared/info-prime.md",
      "next": "info-loop-analysis"
    },
    "info-loop-analysis": {
      "id": "info-loop-analysis",
      "type": "agent",
      "prompt": "planning/_shared/info-loop-analysis.md",
      "next": "info-visit-counter"
    },
    "info-visit-counter": {
      "id": "info-visit-counter",
      "type": "agent",
      "prompt": "planning/_shared/info-visit-counter.md",
      "next": "info-gate-analysis"
    },
    "info-gate-analysis": {
      "id": "info-gate-analysis",
      "type": "agent",
      "prompt": "planning/_shared/info-gate-analysis.md",
      "context": {
        "skip_auto_gate": true
      },
      "next": "info-flow-specific"
    },
    "info-flow-specific": {
      "id": "info-flow-specific",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/info-flow-specific.md",
      "next": "info-schema-ref"
    },
    "info-schema-ref": {
      "id": "info-schema-ref",
      "type": "agent",
      "prompt": "planning/_shared/info-schema-ref.md",
      "next": "info-validity-checks"
    },
    "info-validity-checks": {
      "id": "info-validity-checks",
      "type": "agent",
      "prompt": "planning/_shared/info-validity-checks.md",
      "next": "info-summarize-consumption"
    },
    "info-summarize-consumption": {
      "id": "info-summarize-consumption",
      "type": "agent",
      "prompt": "planning/_shared/info-summarize-consumption.md",
      "next": "seed-gate"
    },
    "seed-gate": {
      "id": "seed-gate",
      "type": "gate",
      "prompt": "planning/plan-collaborative/prompts/seed-gate.md",
      "next": {
        "finalize": {
          "desc": "Approve and write the seed plan",
          "choose_when": "User approved the session design"
        },
        "clarify": {
          "desc": "Revise the session structure",
          "choose_when": "User wants to refine the structure"
        }
      }
    },
    "finalize": {
      "id": "finalize",
      "type": "agent",
      "prompt": "planning/plan-collaborative/prompts/finalize.md"
    }
  }
}
