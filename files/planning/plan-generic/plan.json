    "info-visit-counter": {
      "id": "info-visit-counter",
      "type": "agent",
      "prompt": "planning/_shared/info-visit-counter.md",
      "next": {
        "info-gate-analysis": {
          "desc": "Analyze gate placement options.",
          "choose_when": "Visit counter recommendations recorded."
        }
      }
    },
    "info-gate-analysis": {
      "id": "info-gate-analysis",
      "type": "agent",
      "prompt": "planning/_shared/info-gate-analysis.md",
      "next": {
        "info-flow-specific": {
          "desc": "Review flow-specific considerations.",
          "choose_when": "Gate decisions recorded."
        }
      }
    },
    "info-flow-specific": {
      "id": "info-flow-specific",
      "type": "agent",
      "prompt": "planning/_shared/info-flow-specific.md",
      "next": {
        "info-schema-ref": {
          "desc": "Review schema reference.",
          "choose_when": "Flow-specific notes internalized."
        }
      }
    },
    "info-schema-ref": {
      "id": "info-schema-ref",
      "type": "agent",
      "prompt": "planning/_shared/info-schema-ref.md",
      "next": {
        "info-validity-checks": {
          "desc": "Run validity checks.",
          "choose_when": "Schema reference internalized."
        }
      }
    },
    "info-validity-checks": {
      "id": "info-validity-checks",
      "type": "agent",
      "prompt": "planning/_shared/info-validity-checks.md",
      "next": {
        "info-summarize-consumption": {
          "desc": "Summarize informational phase consumption.",
          "choose_when": "Validity checks complete."
        }
      }
    },
    "info-summarize-consumption": {
      "id": "info-summarize-consumption",
      "type": "agent",
      "prompt": "planning/_shared/info-summarize-consumption.md",
      "next": {
        "review-gate": {
          "desc": "Present the complete plan for user approval.",
          "choose_when": "Summary complete."
        }
      }
