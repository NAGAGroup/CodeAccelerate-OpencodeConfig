        "synthesize": {
          "desc": "Synthesize scout findings into a coherent codebase understanding.",
          "choose_when": "Enough information has been gathered to proceed with decomposition."
        }
      }
    },
    "synthesize": {
      "id": "synthesize",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/synthesize.md",
      "next": {
        "decompose": {
          "desc": "Break the work into concrete, ordered subtasks.",
          "choose_when": "Codebase understanding has been synthesized and presented to the user."
        }
      }
    },
    "scout": {
      "id": "scout",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/scout.md",
      "next": {
        "task-intake": {
          "desc": "Capture and clarify the task description.",
