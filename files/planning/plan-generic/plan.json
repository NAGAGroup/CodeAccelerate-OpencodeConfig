        }
      }
    },
    "decompose": {
      "id": "decompose",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/decompose.md",
      "next": {
        "agent-routing": {
          "desc": "Assign agents and models to each subtask.",
