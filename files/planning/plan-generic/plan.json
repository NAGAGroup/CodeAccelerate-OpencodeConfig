    "clarify": {
      "id": "clarify",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/clarify.md",
      "next": {
        "assess": {
          "desc": "Evaluate whether enough context has been gathered to proceed.",
          "choose_when": "Clarifying question has been asked."
        }
      }
