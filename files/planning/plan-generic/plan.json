{
  "schema_version": "1.0",
  "id": "plan-generic",
  "session_type": "plan-generic",
  "status": "ready",
  "entry": "session-overview",
  "nodes": {
    "session-overview": {
      "id": "session-overview",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/session-overview.md",
      "next": {
        "load-guidelines": {
          "desc": "Load the plan design guidelines and schema reference.",
          "choose_when": "Session overview has been read and internalized."
        }
      }
    },
    "load-guidelines": {
      "id": "load-guidelines",
      "type": "agent",
      "prompt": "planning/plan-design-guidelines.md",
      "next": {
        "scout": {
          "desc": "Dispatch parallel scouts to explore the codebase.",
          "choose_when": "Design guidelines and plan schema have been loaded."
        }
      }
    },
    "task-intake": {
      "id": "task-intake",
      "type": "agent",
      "prompt": "planning/plan-generic/prompts/task-intake.md",
      "next": {
        "clarify": {
          "desc": "Begin asking targeted clarifying questions.",
          "choose_when": "Task description has been captured and initial ambiguities identified."
        }
      }
