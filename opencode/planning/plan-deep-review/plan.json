          "desc": "Proceed to review intake",
          "choose_when": "Scout findings gathered"
        }
      }
    },
    "agent-routing": {
      "id": "agent-routing",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-deep-review/prompts/agent-routing.md",
      "next": {
