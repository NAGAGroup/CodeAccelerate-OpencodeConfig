        },
        "clarify": {
          "desc": "Ask another clarifying question",
          "choose_when": "More clarification needed before routing agents"
        }
      }
    },
    "scout": {
      "id": "scout",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-deep-review/prompts/scout.md",
