        "finalize": {
          "desc": "Generate fix session plan",
          "choose_when": "User approved the fix plan"
        },
        "clarify": {
          "desc": "Loop back to clarify with changes",
          "choose_when": "User requested revisions to the plan"
        }
      }
    },
    "finalize": {
      "id": "finalize",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-deep-review/prompts/finalize.md"
