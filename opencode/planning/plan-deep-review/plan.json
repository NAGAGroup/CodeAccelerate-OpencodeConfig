      "next": {
        "load-guidelines": {
          "desc": "Load plan design guidelines",
          "choose_when": "Session overview read and internalized"
        }
      }
    },
    "load-guidelines": {
      "id": "load-guidelines",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-design-guidelines.md",
      "next": {
        "scout": {
          "desc": "Dispatch scouts to gather review context",
          "choose_when": "Guidelines loaded and understood"
        }
      }
    },
    "review-intake": {
      "id": "review-intake",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-deep-review/prompts/review-intake.md",
      "next": {
        "clarify": {
          "desc": "Ask clarifying questions to refine scope",
          "choose_when": "More information needed before proceeding"
        }
      }
    },
    "clarify": {
      "id": "clarify",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-deep-review/prompts/clarify.md",
      "next": {
        "agent-routing": {
          "desc": "Proceed to agent routing",
