{
  "schema_version": "1.0",
  "id": "plan-collaborative",
  "session_type": "plan-collaborative",
  "description": "Rough-idea-to-detailed-spec — planning produces seed plan only",
  "entry": "session-overview",
  "nodes": {
    "session-overview": {
      "id": "session-overview",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/session-overview.md",
      "next": "load-guidelines"
    },
    "load-guidelines": {
      "id": "load-guidelines",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-design-guidelines.md",
      "next": "idea-intake"
    },
    "idea-intake": {
      "id": "idea-intake",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/idea-intake.md",
      "next": "clarify"
    },
    "clarify": {
      "id": "clarify",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/clarify.md",
      "next": ["clarify", "agent-routing"],
      "remaining_visits": 3
    },
    "agent-routing": {
      "id": "agent-routing",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/agent-routing.md",
      "next": "seed-gate"
    },
    "seed-gate": {
      "id": "seed-gate",
      "type": "gate",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/seed-gate.md",
      "next": ["finalize", "clarify"]
    },
    "finalize": {
      "id": "finalize",
      "type": "agent",
      "prompt": "~/.config/opencode/planning/plan-collaborative/prompts/finalize.md"
    }
  }
}
