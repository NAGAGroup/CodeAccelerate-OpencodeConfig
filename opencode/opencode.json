{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "opencode/big-pickle",
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "default_agent": "headwrench",
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "description": "Primary orchestrator — plans, delegates, drives sessions",
      "model": "anthropic/claude-sonnet-4-6"
    },
    "context-scout": {
      "description": "Read-only situational awareness for pre-planning",
      "model": "anthropic/claude-haiku-4-5"
    },
    "context-insurgent": {
      "description": "Deep multi-file exploration with sequential reasoning",
      "model": "anthropic/claude-sonnet-4-6"
    },
    "deep-researcher": {
      "description": "Web and documentation research via exa and Context7",
      "model": "anthropic/claude-haiku-4-5"
    },
    "compaction": {
      "description": "Context compaction handler",
      "model": "anthropic/claude-haiku-4-5"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}",
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    }
  }
}
