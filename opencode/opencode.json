{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "small_model": "opencode/gpt-5.1-codex-mini",
  "plugin": ["@tarquinen/opencode-dcp@3.0.0"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "default_agent": "headwrench",
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "headwrench": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "subagents/context-scout": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "subagents/context-insurgent": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "subagents/deep-researcher": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "subagents/gates-expert": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "subagents/subagent-builder": {
      "model": "github-copilot/claude-sonnet-4.6"
    },
    "subagents/code-writer": {
      "model": "opencode/gpt-5.3-codex"
    },
    "subagents/doc-writer": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "subagents/architect": {
      "model": "github-copilot/claude-opus-4.6"
    },
    "compaction": {
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}",
      "enabled": false
    }
  }
}
