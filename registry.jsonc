      ]
    },
    {
      "name": "ocx-free",
      "type": "profile",
      "description": "NAGAGroup's free config (using Opencode Zen)",
      "files": [
        {
          "path": "profiles/free/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/free/ocx.jsonc",
          "target": "ocx.jsonc"
        },
        {
          "path": "profiles/free/dcp.jsonc",
          "target": "dcp.jsonc"
        },
        {
          "path": "profiles/free/dcp-prompts/overrides/system.md",
          "target": "dcp-prompts/overrides/system.md"
        },
        {
