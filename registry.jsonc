{
  // OCX Registry Starter Template
  // Use this as a starting point for creating your own component registry
  //
  // Schema reference: https://ocx.kdco.dev/schemas/v2/registry.json
  // Documentation: https://github.com/kdcokenny/ocx
  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "Naga Group",
  // Registry refs use the alias chosen by users via:
  // ocx registry add <url> --name <alias>
  "version": "4.0.0",
  "author": "Jack Myers",
  // Compatibility versions
  "opencode": "1.27.0", // Minimum OpenCode version required
  "ocx": "1.0.16", // Minimum OCX CLI version required
  "components": [
    // Add your components here
    // Supported types:
    //   - skill     - Knowledge modules (markdown files)
    //   - agent     - AI personas with custom prompts
    //   - plugin    - TypeScript plugins that extend functionality
    //   - command   - User-invokable commands
    //   - tool      - Custom tool implementations
    //   - bundle    - Collections of related components
    //   - profile   - Shareable profile configuration
    {
      "name": "ocx-tools",
      "type": "tool",
      "description": "NAGAGroup's plugins and planning scaffolds",
      "files": [
        // Plugin
        "plugins/planning-enforcement.js",
        // Plan session DAG + guide
        "planning/plan-session/plan.jsonl",
        "planning/plan-session/dag-design-guide.md",
        // Planning prompts
        "planning/plan-session/prompts/session-overview.md",
        "planning/plan-session/prompts/orientation-scout.md",
        "planning/plan-session/prompts/external-research.md",
        "planning/plan-session/prompts/user-questions.md",
        "planning/plan-session/prompts/write-notes.md",
        "planning/plan-session/prompts/compress.md",
        "planning/plan-session/prompts/session-overview-refresher.md",
        "planning/plan-session/prompts/dag-design.md",
        "planning/plan-session/prompts/dag-review.md",
        "planning/plan-session/prompts/dag-revision.md",
        "planning/plan-session/prompts/user-review.md",
        "planning/plan-session/prompts/final-revision.md",
        "planning/plan-session/prompts/retrieve-notes.md",
        "planning/plan-session/prompts/plan-success.md",
        // Node library catalogue
        "planning/plan-session/node-library/CATALOGUE.md",
        // Node library: execution-kickoff
        "planning/plan-session/node-library/execution-kickoff/node-spec.json",
        "planning/plan-session/node-library/execution-kickoff/prompt.md",
        // Node library: work-item
        "planning/plan-session/node-library/work-item/node-spec.json",
        "planning/plan-session/node-library/work-item/prompt.md",
        // Node library: project-search-and-analysis
        "planning/plan-session/node-library/project-search-and-analysis/node-spec.json",
        "planning/plan-session/node-library/project-search-and-analysis/prompt.md",
        // Node library: research
        "planning/plan-session/node-library/research/node-spec.json",
        "planning/plan-session/node-library/research/prompt.md",
        // Node library: deep-research
        "planning/plan-session/node-library/deep-research/node-spec.json",
        "planning/plan-session/node-library/deep-research/prompt.md",
        // Node library: write-notes
        "planning/plan-session/node-library/write-notes/node-spec.json",
        "planning/plan-session/node-library/write-notes/prompt.md",
        // Node library: compress
        "planning/plan-session/node-library/compress/node-spec.json",
        "planning/plan-session/node-library/compress/prompt.md",
        // Node library: kickoff-refresher
        "planning/plan-session/node-library/kickoff-refresher/node-spec.json",
        "planning/plan-session/node-library/kickoff-refresher/prompt.md",
        // Node library: sequential-thinking
        "planning/plan-session/node-library/sequential-thinking/node-spec.json",
        "planning/plan-session/node-library/sequential-thinking/prompt.md",
        // Node library: autonomous-work
        "planning/plan-session/node-library/autonomous-work/node-spec.json",
        "planning/plan-session/node-library/autonomous-work/prompt.md",
        // Node library: user-discussion
        "planning/plan-session/node-library/user-discussion/node-spec.json",
        "planning/plan-session/node-library/user-discussion/prompt.md"
      ]
    },
    {
      "name": "ocx-bundle",
      "type": "bundle",
      "description": "NAGAGroup's base opencode distro files",
      "files": [
        // Agents
        "agents/autonomous-agent.md",
        "agents/context-insurgent.md",
        "agents/context-scout.md",
        "agents/documentation-expert.md",
        "agents/external-scout.md",
        "agents/dag-designer.md",
        "agents/dag-reviewer.md",
        "agents/headwrench.md",
        "agents/junior-dev.md",
        "agents/tailwrench.md",
        // Commands
        "commands/activate-plan.md",
        "commands/plan-session.md",
        // Skills
        "skills/asking-questions/SKILL.md",
        "skills/autonomous-agent-delegation/SKILL.md",
        "skills/context-insurgent-delegation/SKILL.md",
        "skills/context-scout-delegation/SKILL.md",
        "skills/dag-design/SKILL.md",
        "skills/dag-review/SKILL.md",
        "skills/documentation-expert-delegation/SKILL.md",
        "skills/external-scout-delegation/SKILL.md",
        "skills/following-plans/SKILL.md",
        "skills/grepai/SKILL.md",
        "skills/juniordev-delegation/SKILL.md",
        "skills/qdrant-notes/SKILL.md",
        "skills/sequential-thinking/SKILL.md",
        "skills/tailwrench-delegation/SKILL.md"
      ],
      "dependencies": [
        "ocx-tools"
      ]
    },
    {
      "name": "ocx-default",
      "type": "profile",
      "description": "NAGAGroup's default profile (Anthropic)",
      "files": [
        {
          "path": "profiles/default/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/default/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-copilot",
      "type": "profile",
      "description": "NAGAGroup's copilot profile",
      "files": [
        {
          "path": "profiles/copilot/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/copilot/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-haiku",
      "type": "profile",
      "description": "NAGAGroup's haiku profile (Anthropic, all haiku models)",
      "files": [
        {
          "path": "profiles/haiku/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/haiku/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-haiku-copilot",
      "type": "profile",
      "description": "NAGAGroup's haiku copilot profile (GitHub Copilot, all haiku models)",
      "files": [
        {
          "path": "profiles/haiku-copilot/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/haiku-copilot/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-free",
      "type": "profile",
      "description": "NAGAGroup's free config (using Opencode Zen)",
      "files": [
        {
          "path": "profiles/free/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/free/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-ollama",
      "type": "profile",
      "description": "NAGAGroup's Ollama local profile — run 'ollama cp <model> opencode-model' to set your model",
      "files": [
        { "path": "profiles/ollama/opencode.jsonc", "target": "opencode.jsonc" },
        { "path": "profiles/ollama/ocx.jsonc", "target": "ocx.jsonc" }
      ],
      "dependencies": ["ocx-bundle"]
    }
  ]
}
