{
  // OCX Registry Starter Template
  // Use this as a starting point for creating your own component registry
  //
  // Schema reference: https://ocx.kdco.dev/schemas/v2/registry.json
  // Documentation: https://github.com/kdcokenny/ocx
  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "Naga Group",
  // Registry refs use the alias chosen by users via:
  // ocx registry add <url> --name <alias>
  "version": "2.1.0",
  "author": "Jack Myers",
  // Compatibility versions
  "opencode": "1.27.0", // Minimum OpenCode version required
  "ocx": "1.0.16", // Minimum OCX CLI version required
  "components": [
    // Add your components here
    // Supported types:
    //   - skill     - Knowledge modules (markdown files)
    //   - agent     - AI personas with custom prompts
    //   - plugin    - TypeScript plugins that extend functionality
    //   - command   - User-invokable commands
    //   - tool      - Custom tool implementations
    //   - bundle    - Collections of related components
    //   - profile   - Shareable profile configuration
    {
      "name": "ocx-tools",
      "type": "tool",
      "description": "NAGAGroup's plugins",
      "files": [
        "plugins/planning-enforcement.js",
        "planning/plan-collaborative/plan.json",
        "planning/plan-collaborative/prompts/agent-routing.md",
        "planning/plan-collaborative/prompts/assess.md",
        "planning/plan-collaborative/prompts/clarify.md",
        "planning/plan-collaborative/prompts/finalize.md",
        "planning/plan-collaborative/prompts/idea-intake.md",
        "planning/plan-collaborative/prompts/load-guidelines.md",
        "planning/plan-collaborative/prompts/scout.md",
        "planning/plan-collaborative/prompts/seed-gate.md",
        "planning/plan-collaborative/prompts/session-overview.md",
        "planning/plan-collaborative/prompts/info-flow-specific.md",
        "planning/plan-debug/plan.json",
        "planning/plan-debug/prompts/agent-routing.md",
        "planning/plan-debug/prompts/bug-intake.md",
        "planning/plan-debug/prompts/confirm-mode.md",
        "planning/plan-debug/prompts/context-gather.md",
        "planning/plan-debug/prompts/finalize.md",
        "planning/plan-debug/prompts/hypothesis-form.md",
        "planning/plan-debug/prompts/load-guidelines.md",
        "planning/plan-debug/prompts/session-overview.md",
        "planning/plan-debug/prompts/info-flow-specific.md",
        "planning/plan-deep-research/plan.json",
        "planning/plan-deep-research/prompts/agent-routing.md",
        "planning/plan-deep-research/prompts/assess.md",
        "planning/plan-deep-research/prompts/clarify.md",
        "planning/plan-deep-research/prompts/finalize.md",
        "planning/plan-deep-research/prompts/load-guidelines.md",
        "planning/plan-deep-research/prompts/research-gate.md",
        "planning/plan-deep-research/prompts/research-intake.md",
        "planning/plan-deep-research/prompts/scout.md",
        "planning/plan-deep-research/prompts/session-overview.md",
        "planning/plan-deep-research/prompts/info-flow-specific.md",
        "planning/plan-deep-review/plan.json",
        "planning/plan-deep-review/prompts/agent-routing.md",
        "planning/plan-deep-review/prompts/assess.md",
        "planning/plan-deep-review/prompts/clarify.md",
        "planning/plan-deep-review/prompts/finalize.md",
        "planning/plan-deep-review/prompts/load-guidelines.md",
        "planning/plan-deep-review/prompts/review-gate.md",
        "planning/plan-deep-review/prompts/review-intake.md",
        "planning/plan-deep-review/prompts/scout.md",
        "planning/plan-deep-review/prompts/session-overview.md",
        "planning/plan-deep-review/prompts/synthesize.md",
        "planning/plan-deep-review/prompts/info-flow-specific.md",
        "planning/plan-design-guidelines.md",
        "planning/plan-generic/plan.json",
        "planning/plan-generic/prompts/agent-routing.md",
        "planning/plan-generic/prompts/assess.md",
        "planning/plan-generic/prompts/clarify.md",
        "planning/plan-generic/prompts/decompose.md",
        "planning/plan-generic/prompts/finalize.md",
        "planning/plan-generic/prompts/info-flow-specific.md",
        "planning/plan-generic/prompts/review-gate.md",
        "planning/plan-generic/prompts/scout.md",
        "planning/plan-generic/prompts/session-overview.md",
        "planning/plan-generic/prompts/synthesize.md",
        "planning/plan-generic/prompts/task-intake.md",
        "planning/_shared/info-prime.md",
        "planning/_shared/info-loop-analysis.md",
        "planning/_shared/info-visit-counter.md",
        "planning/_shared/info-gate-analysis.md",
        "planning/_shared/info-schema-ref.md",
        "planning/_shared/info-validity-checks.md",
        "planning/_shared/info-summarize-consumption.md"
      ]
    },
    {
      "name": "ocx-bundle",
      "type": "bundle",
      "description": "NAGAGroup's base opencode distro files",
      "files": [
        "agents/context-insurgent.md",
        "agents/context-scout.md",
        "agents/deep-researcher.md",
        "agents/headwrench.md",
        "agents/junior-dev.md",
        "agents/quick-doc.md",
        "commands/activate-plan.md",
        "commands/plan-collaborative.md",
        "commands/plan-debug.md",
        "commands/plan-deep-research.md",
        "commands/plan-deep-review.md",
        "commands/plan-generic.md",
        "skills/delegation/SKILL.md",
        "skills/hello-world/SKILL.md"
      ],
      "dependencies": [
        "ocx-tools"
      ]
    },
    {
      "name": "ocx-default",
      "type": "profile",
      "description": "NAGAGroup's default profile (Anthropic)",
      "files": [
        {
          "path": "profiles/default/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/default/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-copilot",
      "type": "profile",
      "description": "NAGAGroup's copilot profile",
      "files": [
        {
          "path": "profiles/copilot/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/copilot/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-free",
      "type": "profile",
      "description": "NAGAGroup's free config (using Opencode Zen)",
      "files": [
        {
          "path": "profiles/free/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/free/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    }
  ]
}
