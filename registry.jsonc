{
  // OCX Registry Starter Template
  // Use this as a starting point for creating your own component registry
  //
  // Schema reference: https://ocx.kdco.dev/schemas/v2/registry.json
  // Documentation: https://github.com/kdcokenny/ocx
  "$schema": "https://ocx.kdco.dev/schemas/v2/registry.json",
  "name": "Naga Group",
  // Registry refs use the alias chosen by users via:
  // ocx registry add <url> --name <alias>
  "version": "3.4.0",
  "author": "Jack Myers",
  // Compatibility versions
  "opencode": "1.27.0", // Minimum OpenCode version required
  "ocx": "1.0.16", // Minimum OCX CLI version required
  "components": [
    // Add your components here
    // Supported types:
    //   - skill     - Knowledge modules (markdown files)
    //   - agent     - AI personas with custom prompts
    //   - plugin    - TypeScript plugins that extend functionality
    //   - command   - User-invokable commands
    //   - tool      - Custom tool implementations
    //   - bundle    - Collections of related components
    //   - profile   - Shareable profile configuration
    {
      "name": "ocx-tools",
      "type": "tool",
      "description": "NAGAGroup's plugins and planning scaffolds",
      "files": [
        "plugins/planning-enforcement.js",
        "planning/reference/dag-design-guide.md",
        "planning/plan-session/plan.json",
        "planning/plan-session/prompts/session-overview.md",
        "planning/plan-session/prompts/scout.md",
        "planning/plan-session/prompts/sequential-thinking.md",
        "planning/plan-session/prompts/research-gate.md",
        "planning/plan-session/prompts/research-brief.md",
        "planning/plan-session/prompts/scout-node-library.md",
        "planning/plan-session/prompts/propose-plan.md",
        "planning/plan-session/prompts/write-dag.md",
        "planning/plan-session/prompts/activation-gate.md",
        "planning/plan-session/prompts/activate-now.md",
        "planning/plan-session/prompts/plan-complete.md",
        "planning/plan-session/node-library/CATALOGUE.md",
        "planning/plan-session/node-library/analyze-deep/plan.json",
        "planning/plan-session/node-library/analyze-deep/README.md",
        "planning/plan-session/node-library/analyze-deep/prompt-template.md",
        "planning/plan-session/node-library/compression-node/plan.json",
        "planning/plan-session/node-library/compression-node/README.md",
        "planning/plan-session/node-library/compression-node/prompt-template.md",
        "planning/plan-session/node-library/conditional-branch/plan.json",
        "planning/plan-session/node-library/conditional-branch/README.md",
        "planning/plan-session/node-library/conditional-branch/prompt-template.md",
        "planning/plan-session/node-library/decision-gate/plan.json",
        "planning/plan-session/node-library/decision-gate/README.md",
        "planning/plan-session/node-library/decision-gate/prompt-template.md",
        "planning/plan-session/node-library/generic/plan.json",
        "planning/plan-session/node-library/generic/README.md",
        "planning/plan-session/node-library/generic/prompt-template.md",
        "planning/plan-session/node-library/output-failure/plan.json",
        "planning/plan-session/node-library/output-failure/README.md",
        "planning/plan-session/node-library/output-failure/prompt-template.md",
        "planning/plan-session/node-library/output-success/plan.json",
        "planning/plan-session/node-library/output-success/README.md",
        "planning/plan-session/node-library/output-success/prompt-template.md",
        "planning/plan-session/node-library/parallel-tasks/plan.json",
        "planning/plan-session/node-library/parallel-tasks/README.md",
        "planning/plan-session/node-library/parallel-tasks/prompt-template.md",
        "planning/plan-session/node-library/scout-parallel/plan.json",
        "planning/plan-session/node-library/scout-parallel/README.md",
        "planning/plan-session/node-library/scout-parallel/prompt-template.md",
        "planning/plan-session/node-library/sequential-thinking/plan.json",
        "planning/plan-session/node-library/sequential-thinking/README.md",
        "planning/plan-session/node-library/sequential-thinking/prompt-template.md",
        "planning/plan-session/node-library/session-overview/plan.json",
        "planning/plan-session/node-library/session-overview/README.md",
        "planning/plan-session/node-library/session-overview/prompt-template.md",
        "planning/plan-session/node-library/verification-check/plan.json",
        "planning/plan-session/node-library/verification-check/README.md",
        "planning/plan-session/node-library/verification-check/prompt-template.md"
      ]
    },
    {
      "name": "ocx-bundle",
      "type": "bundle",
      "description": "NAGAGroup's base opencode distro files",
      "files": [
        "agents/context-insurgent.md",
        "agents/context-scout.md",
        "agents/deep-researcher.md",
        "agents/headwrench.md",
        "agents/junior-dev.md",
        "agents/quick-doc.md",
        "commands/activate-plan.md",
        "commands/plan-session.md",
        "skills/hello-world/SKILL.md"
      ],
      "dependencies": [
        "ocx-tools"
      ]
    },
    {
      "name": "ocx-default",
      "type": "profile",
      "description": "NAGAGroup's default profile (Anthropic)",
      "files": [
        {
          "path": "profiles/default/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/default/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-copilot",
      "type": "profile",
      "description": "NAGAGroup's copilot profile",
      "files": [
        {
          "path": "profiles/copilot/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/copilot/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-haiku",
      "type": "profile",
      "description": "NAGAGroup's haiku profile (Anthropic, all haiku models)",
      "files": [
        {
          "path": "profiles/haiku/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/haiku/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-haiku-copilot",
      "type": "profile",
      "description": "NAGAGroup's haiku copilot profile (GitHub Copilot, all haiku models)",
      "files": [
        {
          "path": "profiles/haiku-copilot/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/haiku-copilot/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-free",
      "type": "profile",
      "description": "NAGAGroup's free config (using Opencode Zen)",
      "files": [
        {
          "path": "profiles/free/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/free/ocx.jsonc",
          "target": "ocx.jsonc"
        }
      ],
      "dependencies": [
        "ocx-bundle"
      ]
    },
    {
      "name": "ocx-ollama",
      "type": "profile",
      "description": "NAGAGroup's Ollama local profile — model configured via OLLAMA_MODEL env var",
      "files": [
        { "path": "profiles/ollama/opencode.jsonc", "target": "opencode.jsonc" },
        { "path": "profiles/ollama/ocx.jsonc", "target": "ocx.jsonc" }
      ],
      "dependencies": ["ocx-bundle"]
    }
  ]
}
