      "files": [
        {
          "path": "profiles/haiku/opencode.jsonc",
          "target": "opencode.jsonc"
        },
        {
          "path": "profiles/haiku/ocx.jsonc",
          "target": "ocx.jsonc"
        },
        {
          "path": "profiles/haiku/dcp.jsonc",
          "target": "dcp.jsonc"
        },
        {
          "path": "profiles/haiku/dcp-prompts/overrides/system.md",
          "target": "dcp-prompts/overrides/system.md"
        },
        {
